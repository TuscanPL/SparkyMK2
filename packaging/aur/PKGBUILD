# Maintainer: TuscanPL <okarinpl@gmail.com>
#
# AUR package, built from a tagged release. scripts/release.sh sets pkgver; after the tag
# is on GitHub, run `updpkgsums` and `makepkg --printsrcinfo > .SRCINFO` before publishing
# (see docs/releasing.md).

pkgname=sparkymk2
pkgver=0.5.0
pkgrel=1
pkgdesc='Editor and librarian for the Roland SP-404MKII'
arch=('x86_64')
url='https://github.com/TuscanPL/SparkyMK2'
license=('GPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'glib2' 'cairo' 'gdk-pixbuf2' 'dbus' 'systemd-libs' 'gcc-libs' 'glibc' 'hicolor-icon-theme')
makedepends=('cargo' 'nodejs' 'npm' 'pkgconf')
options=('!lto' '!debug')
install=sparkymk2.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

_srcdir() {
  printf '%s' "$srcdir/SparkyMK2-$pkgver"
}

prepare() {
  cd "$(_srcdir)"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
  cd app
  npm ci
}

build() {
  cd "$(_srcdir)/app"
  export RUSTUP_TOOLCHAIN=stable
  # Keep build paths out of the binary (panic locations would name $srcdir).
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/"
  npx --no-install tauri build --no-bundle -- --frozen
}

check() {
  cd "$(_srcdir)"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "$(_srcdir)"
  install -Dm755 target/release/sparkymk2 "$pkgdir/usr/bin/sparkymk2"
  install -Dm644 packaging/linux/sparkymk2.desktop "$pkgdir/usr/share/applications/sparkymk2.desktop"
  install -Dm644 packaging/linux/70-sp404mkii.rules "$pkgdir/usr/lib/udev/rules.d/70-sp404mkii.rules"

  local icons=app/src-tauri/icons hicolor="$pkgdir/usr/share/icons/hicolor"
  install -Dm644 "$icons/32x32.png" "$hicolor/32x32/apps/sparkymk2.png"
  install -Dm644 "$icons/64x64.png" "$hicolor/64x64/apps/sparkymk2.png"
  install -Dm644 "$icons/128x128.png" "$hicolor/128x128/apps/sparkymk2.png"
  install -Dm644 "$icons/128x128@2x.png" "$hicolor/256x256/apps/sparkymk2.png"
  install -Dm644 "$icons/icon.png" "$hicolor/512x512/apps/sparkymk2.png"
}
