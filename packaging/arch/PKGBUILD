# Maintainer: TuscanPL <okarinpl@gmail.com>
#
# Builds the desktop app from this repository's checkout. update.sh next to this file
# builds and installs it in one step.

pkgname=sparkymk2
# The repository root, two levels above this file.
_root="$startdir/../.."
# Version from Cargo.toml plus the commit, computed here rather than in pkgver() so
# builds don't rewrite this file.
pkgver=$(cd "$_root" && printf '%s.r%s.g%s' \
  "$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)" \
  "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)")
pkgrel=1
pkgdesc='Editor and librarian for the Roland SP-404MKII'
arch=('x86_64')
url='https://github.com/TuscanPL/SparkyMK2'
license=('GPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'glib2' 'cairo' 'gdk-pixbuf2' 'dbus' 'systemd-libs' 'gcc-libs' 'glibc' 'hicolor-icon-theme')
makedepends=('cargo' 'nodejs' 'npm' 'pkgconf' 'git')
options=('!lto' '!debug')

build() {
  cd "$_root/app"
  npm ci
  npm run tauri build -- --no-bundle
}

package() {
  cd "$_root"
  install -Dm755 target/release/sparkymk2 "$pkgdir/usr/bin/sparkymk2"
  install -Dm644 packaging/linux/sparkymk2.desktop "$pkgdir/usr/share/applications/sparkymk2.desktop"

  local icons=app/src-tauri/icons hicolor="$pkgdir/usr/share/icons/hicolor"
  install -Dm644 "$icons/32x32.png" "$hicolor/32x32/apps/sparkymk2.png"
  install -Dm644 "$icons/64x64.png" "$hicolor/64x64/apps/sparkymk2.png"
  install -Dm644 "$icons/128x128.png" "$hicolor/128x128/apps/sparkymk2.png"
  install -Dm644 "$icons/128x128@2x.png" "$hicolor/256x256/apps/sparkymk2.png"
  install -Dm644 "$icons/icon.png" "$hicolor/512x512/apps/sparkymk2.png"
  install -Dm644 "$icons/icon.svg" "$hicolor/scalable/apps/sparkymk2.svg"
}
